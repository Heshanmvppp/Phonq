// Prisma schema for Phonq.
// Database: Neon (serverless PostgreSQL). Driver adapter: @prisma/adapter-neon.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  playlists     Playlist[]
  favorites     Favorite[]
  listens       Listen[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean         @default(true)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@map("playlists")
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([trackId])
  @@map("playlist_tracks")
}

model Favorite {
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([trackId])
  @@map("favorites")
}

model Listen {
  id         String   @id @default(cuid())
  userId     String
  trackId    String
  progress   Float    @default(0)
  completed  Boolean  @default(false)
  listenedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt])
  @@unique([userId, trackId])
  @@map("listens")
}

/// Offline catalog cache. Tracks are upserted on every successful live fetch
/// so the app can keep serving a "smaller catalog" if the upstream API goes
/// down (Jamendo suspensions, network failures, rate limits).
model CachedTrack {
  id                   String   @id
  name                 String
  duration             Int      @default(0)
  artistId             String?
  artistName           String   @default("Unknown Artist")
  albumId              String?
  albumName            String   @default("Unknown Album")
  audioUrl             String   @default("")
  downloadUrl          String?
  image                String?
  imageSmall           String?
  licenseName          String?
  genre                String?
  bpm                  Int?
  speed                String?
  vocalInstrumental    String?
  tags                 String?
  popularityWeek       Int      @default(0)
  popularityTotal      Int      @default(0)
  listensTotal         Int      @default(0)
  downloadsTotal       Int      @default(0)
  releaseDate          String?
  audioDownloadAllowed Boolean  @default(false)
  source               String   @default("jamendo")
  cachedAt             DateTime @default(now())

  @@index([cachedAt])
  @@index([artistName])
  @@map("cached_tracks")
}

/// Single-row catalog health/status flag. Lets the frontend and /api/health
/// report "live | degraded | static" so clients can surface cached/fallback
/// content proactively instead of waiting for a failed request.
model CatalogStatus {
  id          Int       @id @default(1)
  provider    String    @default("live") // "live" | "degraded" | "static"
  cacheCount  Int       @default(0)
  lastSuccess DateTime?
  lastFailure DateTime?
  error       String?
  radios      Json?
  updatedAt   DateTime  @updatedAt

  @@map("catalog_status")
}
