# ------------------------------------------------------------------
# Phonq environment variables
# Copy this file to `.env` and fill in real values before running.
# ------------------------------------------------------------------

# --- Database -------------------------------------------------------
# Local dev (docker-compose) — pre-wired, works out of the box:
DATABASE_URL="postgresql://phonq:phonq@localhost:5432/phonq?sslmode=disable"
#
# Neon (serverless, pooled) — replace the line above for production:
#   https://console.neon.tech -> your project -> Connection Details -> pooled
# NOTE: remove `channel_binding=require` from Neon's copied URL — Prisma's
# engine cannot connect with that parameter (P1001), only the JS driver can.
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------
# Secret. Generate one with:  openssl rand -base64 32
# Replace this placeholder with a real secret (openssl rand -base64 32)
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Google OAuth 2.0 credentials (optional — omit to disable Google sign-in)
# https://console.cloud.google.com/apis/credentials
# Add redirect URI:  https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# Email magic-link sign-in (optional — omit to disable email sign-in)
# Get a free key at https://resend.com, then verify your sending domain.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="noreply@phonq.app"

# --- App URL ---------------------------------------------------------
# Canonical app URL (used for OG tags, absolute links, auth redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Catalog ----------------------------------------------------------
# Jamendo API client id (https://devportal.jamendo.com -> Applications).
# Phonq does not ship a working key — shared test keys get suspended by Jamendo.
# Without a valid key the app falls back to the Postgres catalog cache and then
# to the bundled static snapshot, so the UI never breaks.
JAMENDO_CLIENT_ID=""

# --- YouTube (optional hybrid catalog fill) ----------------------------
# YouTube Data API v3 service-account keys. Phonq pools up to 10 GCP projects
# (https://console.cloud.google.com/apis/credentials) for ~100k units/day total
# (~10k per project, free tier). Comma- OR newline-separated:
#
#   YOUTUBE_API_KEYS="key-project-1,key-project-2,..."
#
# All keys serve live `search.list` calls (100 units each → ~1,000 live
# searches/day on a full 10-key pool); the router picks the least-loaded key and
# rotates away from any key YouTube rejects. Setting `YOUTUBE_SEARCH_PROJECTS`
# to N>0 instead reserves the first N keys for live searches and leaves the rest
# for the cheap 1-unit `videos.list`/`playlistItems.list` ops.
# A single legacy `YOUTUBE_API_KEY` still works (one project, no split).
# Without any key the app runs Jamendo-only.
YOUTUBE_API_KEYS=""
# YOUTUBE_API_KEY=""
# YOUTUBE_SEARCH_PROJECTS=""
# YOUTUBE_DAILY_QUOTA_PER_PROJECT="10000"

# --- YouTube catalog cache (Redis accelerator) -------------------------
# Layer 2 Redis "accelerator". It is optional — when absent the app degrades
# transparently to Postgres (Redis is an accelerator, not a dependency). Upstash
# REST is the recommended provider (https://upstash.com/redis). For self-host dev
# you can omit these — the in-process memory shim covers single-instance dev.
UPSTASH_REDIS_REST_URL="https://<db-id>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
#
# Capacity is configured ON THE PROVIDER, not here. In the Upstash console set:
#   maxmemory 200mb
#   maxmemory-policy allkeys-lru
# That ≈1.3M usable ~150-byte entries — enough to cache the whole catalog's
# hot-lookup keys plus per-song metadata, not a thin recent-query slice.
#
# Key inventory (TTLs env-overridable, defaults below):
#   search:{normalized_query}  → video_id        TTL 24h
#   song:{video_id}            → small JSON       TTL 12h  (read-through, Postgres only on cold/writes)
#   neg:{normalized_query}     → "1"              TTL 2h   (negative cache)
#   quota:{project}:{op}:{date}→ counter          TTL 24h
#   ratelimit:{bucket}:{key}   → counter          TTL = window+1s
# YOUTUBE_REDIS_SEARCH_TTL="86400"
# YOUTUBE_REDIS_SONG_TTL="43200"
# YOUTUBE_REDIS_NEG_TTL="7200"
#
# Redis traffic is metered in-process (approx bytes read/written + hit/miss) and
# flushed to the `redis_usage_log` table (daily row) alongside `api_call_log`
# whenever a YouTube API call is recorded — so the monthly egress budget
# (~10 GB on Upstash's free tier ≈ 1M+ lookups/day) is visible before the
# provider throttles. See GET /api/youtube/quota → `.redis`.
# YOUTUBE_RUNTIME_FILL="1"
# Hard cap on daily `search.list` calls (overrides the pool-derived budget).
# Lower than the pool default only if you want a smaller live-search cushion.
# YOUTUBE_DAILY_SEARCH_BUDGET="100"

# --- YouTube dedicated catalog DB (Layer 3) ----------------------------
# Optional: a dedicated Neon DB for the lean `songs` catalog, isolated from your
# main app DB (`users`, `playlists`, ...) so a runaway seed can't touch user data.
# Point it at a Neon project; the SAME schema (incl. `songs`/`api_call_log`/
# `redis_usage_log`) must be migrated there
# (`DATABASE_URL=$YOUTUBE_DATABASE_URL npm run db:migrate`).
# When unset, the catalog tables live in the main DATABASE_URL above.
YOUTUBE_DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/youtube?sslmode=require"
# Monthly prune tuning for `songs` (npm run prune:youtube -- --apply).
YOUTUBE_PRUNE_MIN_QUALITY="30"
YOUTUBE_PRUNE_MAX_AGE_DAYS="60"

# --- YouTube track downloads (yt-dlp) ----------------------------------
# Optional. Serving `/api/download/:videoId` (downloads for YouTube-sourced
# tracks) shells out to `yt-dlp` + `ffmpeg` on the host — both are installed by
# the included Dockerfile. Override the binary path if yt-dlp lives elsewhere.
# If yt-dlp isn't available, YouTube tracks simply keep no download button.
# YTDLP_BINARY="yt-dlp"
